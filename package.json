{
  "name": "juju-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node server/server.js",
    "build-client": "esbuild src/main.js --bundle --outfile=server/public/dist/main.js --sourcemap && mkdir -p server/public && cp index.html styles.css server/public/",
    "build": "npm run build-client"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.18.0"
  }
}
